{
  "name": "@uzllm/apps",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "dashboard",
    "admin"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace @uzllm/dashboard --",
    "dev:admin": "npm run dev --workspace @uzllm/admin --",
    "build": "npm run build --workspaces",
    "test:e2e": "npm run test:e2e --workspace @uzllm/dashboard",
    "api:generate": "node tools/api-contracts.mjs",
    "api:check": "node tools/api-contracts.mjs --check",
    "api:test": "node --test tools/api-contracts.test.mjs",
    "api:types": "tsc --project tools/tsconfig.contracts.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0"
  }
}
