                              "type",
                              "function"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "role"
                      ],
                      "type": "object"
                    },
                    "maxItems": 256,
                    "minItems": 1,
                    "type": "array"
                  },
                  "model": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  "response_format": {
                    "properties": {
                      "json_schema": {
                        "properties": {
