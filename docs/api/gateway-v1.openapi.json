{
  "components": {
    "securitySchemes": {
      "GatewayKey": {
        "description": "Project-scoped UZLLM gateway key; never a provider key.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Implemented OpenAI-compatible models/chat contract. Responses and embeddings are not yet supported. Breaking changes require a versioned path and 180 days of migration overlap.",
    "title": "UZLLM Gateway API",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "description": "Bounded chat subset; unsupported fields return 400. max_tokens and max_completion_tokens are mutually exclusive. Tool/vision/structured-output capability is checked against the selected mapping. After output begins, no replay/fallback occurs. Unknown usage leaves settlement pending, never a zero-cost claim.",
        "operationId": "CreateChatCompletion",
        "parameters": [
          {
            "description": "Non-empty UUID, scoped to organization/key/operation for 24 hours. Replay returns 409 and X-Original-Request-Id; completion bodies are not replayed.",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "max_completion_tokens": 32,
                "messages": [
                  {
                    "content": "Hello",
                    "role": "user"
                  }
                ],
                "model": "example-chat",
                "stream": false
              },
              "schema": {
                "additionalProperties": false,
                "not": {
                  "required": [
                    "max_tokens",
                    "max_completion_tokens"
                  ]
                },
                "properties": {
                  "max_completion_tokens": {
                    "format": "int32",
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "max_tokens": {
                    "format": "int32",
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "messages": {
                    "items": {
                      "description": "Content is required except assistant tool-call messages. Only user messages accept HTTPS image URLs; only assistant messages accept tool_calls; tool messages require tool_call_id and one text content part.",
                      "properties": {
                        "content": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            },
                            {
                              "items": {
                                "oneOf": [
                                  {
                                    "properties": {
                                      "text": {
                                        "type": "string"
                                      },
                                      "type": {
                                        "enum": [
                                          "text"
                                        ],
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "type",
                                      "text"
                                    ],
                                    "type": "object"
                                  },
                                  {
                                    "properties": {
                                      "image_url": {
                                        "properties": {
                                          "detail": {
                                            "enum": [
                                              "auto",
                                              "low",
                                              "high"
                                            ],
                                            "type": "string"
                                          },
                                          "url": {
                                            "type": "string"
                                          }
                                        },
                                        "required": [
                                          "url"
                                        ],
                                        "type": "object"
                                      },
                                      "type": {
                                        "enum": [
                                          "image_url"
                                        ],
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "type",
                                      "image_url"
                                    ],
                                    "type": "object"
                                  }
                                ]
                              },
                              "type": "array"
                            }
                          ]
                        },
                        "role": {
                          "enum": [
                            "system",
                            "developer",
                            "user",
                            "assistant",
                            "tool"
                          ],
                          "type": "string"
                        },
                        "tool_call_id": {
                          "type": "string"
                        },
                        "tool_calls": {
                          "items": {
                            "properties": {
                              "function": {
                                "properties": {
                                  "arguments": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "name",
                                  "arguments"
                                ],
                                "type": "object"
                              },
                              "id": {
                                "type": "string"
                              },
                              "type": {
