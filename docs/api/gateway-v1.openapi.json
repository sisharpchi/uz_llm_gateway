                      "required": [
                        "type",
                        "function"
                      ],
                      "type": "object"
                    },
                    "maxItems": 64,
                    "type": "array"
                  },
                  "top_p": {
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "type": "number"
                  },
                  "uzllm": {
                    "additionalProperties": false,
                    "description": "provider_key_id must be non-empty. Managed fallback opt-in requires provider_key_id. Fallback codes must be canonical and distinct from the requested model; BYOK cross-model fallback requires Managed opt-in.",
                    "properties": {
                      "allow_managed_fallback": {
                        "type": "boolean"
                      },
                      "fallback_models": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 2,
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      },
                      "provider_key_id": {
                        "format": "uuid",
                        "type": "string"
                      },
                      "routing": {
                        "enum": [
                          "price",
                          "latency",
                          "throughput",
                          "auto"
                        ],
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
