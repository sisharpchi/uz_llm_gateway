                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "temperature": {
                    "maximum": 2,
                    "minimum": 0,
                    "type": "number"
                  },
                  "tool_choice": {
                    "oneOf": [
                      {
                        "enum": [
                          "auto",
                          "none",
