POSTGRES_DB=uzllm
POSTGRES_MIGRATOR_USER=uzllm_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-local-migrator-password
POSTGRES_RUNTIME_USER=uzllm_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-a-local-runtime-password
APIKEYS__FINGERPRINTKEY=replace-with-a-base64-encoded-32-byte-key
PROVIDERSECRETS__ACTIVEKEYVERSION=v1
PROVIDERSECRETS__KEYS__v1=replace-with-a-different-base64-encoded-32-byte-key
PAYLOADSECRETS__ACTIVEKEYVERSION=v1
PAYLOADSECRETS__KEYS__v1=replace-with-a-separate-base64-encoded-32-byte-key
UZLLM_SMTP_HOST=replace-with-your-starttls-smtp-host
UZLLM_SMTP_PORT=587
UZLLM_SMTP_FROM=noreply@example.uz
UZLLM_OPERATIONS_ALERT_EMAIL=oncall@example.uz
TELEGRAM__BOTUSERNAME=replace-with-your-bot-username
TELEGRAM__BOTTOKEN=replace-with-your-bot-token
TELEGRAM__WEBHOOKSECRET=replace-with-a-16-to-256-character-url-safe-secret
TELEGRAM__ACTIVECHATKEYVERSION=v1
TELEGRAM__CHATKEYS__v1=replace-with-a-dedicated-base64-encoded-32-byte-key
OUTBOUNDWEBHOOKS__ACTIVEKEYVERSION=v1
OUTBOUNDWEBHOOKS__KEYS__v1=replace-with-a-separate-base64-encoded-32-byte-key
