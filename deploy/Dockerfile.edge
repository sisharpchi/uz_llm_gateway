FROM node:22-alpine AS ui
WORKDIR /source/frontend/apps
COPY frontend/apps/package.json frontend/apps/package-lock.json ./
COPY frontend/apps/dashboard/package.json dashboard/package.json
COPY frontend/apps/admin/package.json admin/package.json
COPY frontend/packages/api-client ../packages/api-client
RUN npm ci
# The workspace lock was generated on Windows and omits Rolldown's Linux
# optional native binding. Pin the build-only binding until the lock is
# regenerated on a cross-platform release workstation.
RUN npm install --no-save --package-lock=false @rolldown/binding-linux-x64-musl@1.2.11
COPY frontend/apps/dashboard dashboard
COPY frontend/apps/admin admin
RUN npm run build

FROM nginx:stable-alpine
COPY deploy/nginx/edge.conf /etc/nginx/templates/nginx.conf.template
COPY --from=ui /source/frontend/apps/dashboard/dist /usr/share/nginx/html/dashboard
COPY --from=ui /source/frontend/apps/admin/dist /usr/share/nginx/html/admin
