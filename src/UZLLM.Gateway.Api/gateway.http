@baseUrl = https://localhost:7057
@apiKey = uzllm_live_replace_with_issued_key
@providerKeyId = 00000000-0000-0000-0000-000000000003

### List enabled models
GET {{baseUrl}}/v1/models
Authorization: Bearer {{apiKey}}

### Non-streaming chat completion
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Idempotency-Key: 3f00af3b-b1af-4ae3-8d72-0d8a22bda093

{
  "model": "gpt-4o-mini",
  "messages": [{ "role": "user", "content": "Hello" }],
  "max_completion_tokens": 100,
  "stream": false
}

### Streaming chat completion
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "openai/gpt-4o-mini",
  "messages": [{ "role": "user", "content": "Hello" }],
  "max_completion_tokens": 100,
  "stream": true
}

### BYOK only (the customer pays the provider directly)
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"model":"gpt-4o-mini","messages":[{"role":"user","content":"Hello"}],"max_completion_tokens":100,"uzllm":{"provider_key_id":"{{providerKeyId}}"}}

### Cheapest eligible Managed route (same canonical model)
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"model":"gpt-4o-mini","messages":[{"role":"user","content":"Hello"}],"max_completion_tokens":100,"uzllm":{"routing":"price"}}

### Explicit ordered model fallback (use real active canonical model codes)
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"model":"gpt-4o-mini","messages":[{"role":"user","content":"Hello"}],"max_completion_tokens":100,"uzllm":{"fallback_models":["fallback-model-a","fallback-model-b"]}}

### Explicit Hybrid: managed fallback only for verified pre-execution rejection
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{"model":"gpt-4o-mini","messages":[{"role":"user","content":"Hello"}],"max_completion_tokens":100,"uzllm":{"provider_key_id":"{{providerKeyId}}","allow_managed_fallback":true}}

### Explicit unsupported parameter error
POST {{baseUrl}}/v1/chat/completions
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "gpt-4o-mini",
  "messages": [{ "role": "user", "content": "Hello" }],
  "n": 3
}
