@baseUrl = https://localhost:7150
@org = 11111111-1111-4111-8111-111111111111
@id = 22222222-2222-4222-8222-222222222222
@session = replace-local-operator-session
@csrf = replace-local-session-csrf

### Requires a separately configured approved profile. Synthetic fixtures are not live authority.
POST {{baseUrl}}/management/v1/admin/organizations/{{org}}/reporting-evidence/fiscal
Cookie: __Host-uzllm-session={{session}}; __Host-uzllm-csrf={{csrf}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "profileId": "synthetic-evidence", "profileVersion": 1,
  "idempotencyKey": "33333333-3333-4333-8333-333333333333",
  "externalOperationReference": "external-test-operation", "outcome": "Unknown",
  "externalProcessReference": "external-review-test", "reason": "Synthetic unknown external observation"
}

### No signed terms: still EvidenceOnly, no default compensation tariff.
POST {{baseUrl}}/management/v1/admin/organizations/{{org}}/reporting-evidence/contracts
Cookie: __Host-uzllm-session={{session}}; __Host-uzllm-csrf={{csrf}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "profileId": "synthetic-evidence", "profileVersion": 1,
  "idempotencyKey": "44444444-4444-4444-8444-444444444444",
  "contractId": "synthetic-contract", "policyVersion": "v1", "serviceScopeId": "evidence-chat",
  "customerIdentityReference": "synthetic-customer-snapshot", "effectiveFrom": "2026-01-01T00:00:00Z",
  "effectiveTo": "2027-01-01T00:00:00Z", "state": "EvidenceOnly", "reason": "Synthetic contract provenance"
}

### IDs must identify an existing same-org contract and published statement; no implicit latest.
POST {{baseUrl}}/management/v1/admin/organizations/{{org}}/reporting-evidence/links
Cookie: __Host-uzllm-session={{session}}; __Host-uzllm-csrf={{csrf}}
X-CSRF-Token: {{csrf}}
Content-Type: application/json

{
  "idempotencyKey": "55555555-5555-4555-8555-555555555555", "contractReferenceId": "{{id}}",
  "periodStart": "2026-09-01T00:00:00Z", "statementVersionId": "66666666-6666-4666-8666-666666666666",
  "reason": "Synthetic version-pinned evidence link"
}

### kind is fiscal, contracts or links. Cursor binds organization/kind/page size.
GET {{baseUrl}}/management/v1/admin/organizations/{{org}}/reporting-evidence/fiscal?limit=20
Cookie: __Host-uzllm-session={{session}}

### Missing/out-of-org ID returns 404, not another tenant's evidence.
GET {{baseUrl}}/management/v1/admin/organizations/{{org}}/reporting-evidence/fiscal/{{id}}
Cookie: __Host-uzllm-session={{session}}
